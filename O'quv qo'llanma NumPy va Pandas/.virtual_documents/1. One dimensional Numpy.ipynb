import numpy as np

# Ro'yxatni NumPy massiviga o'tkazish (Casting list to array)
a = np.array([0, 1, 2, 3, 4])

print(f"Massiv: {a}")
print(f"Turi: {type(a)}") # <class 'numpy.ndarray'>
print(f"Ma'lumot turi: {a.dtype}") # Elementlar turi (masalan, int64)





















